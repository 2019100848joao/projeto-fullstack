APP_NAME="Web Backend"
APP_ENV="development"
DEBUG=true
SECRET_KEY="change-this-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=30
RUN_MIGRATIONS_ON_STARTUP=true
DATABASE_URL="postgresql+psycopg://clinic_user:clinic_password@localhost:5432/clinic_db"
SEED_ADMIN_ON_STARTUP=true
# Optional when APP_ENV="development" (local defaults: admin@clinic.com / Admin123!).
# Required in any other environment, otherwise the admin seed is skipped.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_FULL_NAME="Clinic Administrator"
